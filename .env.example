NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Pooled runtime URL (Supabase transaction pooler, port 6543).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1
# Session pooler URL used by Prisma migrations (port 5432).
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Use "log" locally. Set to "resend" only after configuring the fields below.
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=Life's Details <bookings@example.com>
